# Public Expo configuration
# EXPO_PUBLIC_ values are bundled into the installed mobile application.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_DEFAULT_LOCALE=en
EXPO_PUBLIC_DEFAULT_CURRENCY=SEK
EXPO_PUBLIC_SUPPORT_EMAIL=

# EAS_PROJECT_ID identifies an Expo project but is not a private provider credential.
EAS_PROJECT_ID=

# Physical devices cannot reach the development computer through localhost.
# Replace localhost in the local .env with the computers LAN IP when testing on a phone.

# Never add provider keys, database URLs, JWT secrets, or email credentials here.
