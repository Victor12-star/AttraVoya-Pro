{
  "name": "@attravoya/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AttraVoya Pro Expo mobile application for Android and iOS.",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform all --output-dir dist",
    "lint": "eslint . --max-warnings=0",
    "check:js": "node ../../scripts/check-javascript.js . tooling",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "clean": "node -e \"const fs=require('node:fs'); for(const path of ['.expo','dist','coverage']) fs.rmSync(path,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@attravoya/api-client": "workspace:*",
    "@attravoya/constants": "workspace:*",
    "@attravoya/design-tokens": "workspace:*",
    "@attravoya/localization": "workspace:*",
    "@attravoya/shared-types": "workspace:*",
    "@attravoya/utilities": "workspace:*",
    "@attravoya/validation": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.18",
    "expo-constants": "57.0.16",
    "expo-linking": "57.0.8",
    "expo-location": "57.0.14",
    "expo-notifications": "57.0.15",
    "expo-router": "57.0.17",
    "expo-secure-store": "57.0.2",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@attravoya/eslint-config": "workspace:*",
    "@attravoya/javascript-config": "workspace:*",
    "@jest/globals": "29.7.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "eas-cli": "22.2.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3"
  }
}
