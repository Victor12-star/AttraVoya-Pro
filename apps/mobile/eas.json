{
  "cli": {
    "version": "22.2.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "development",
      "node": "24.20.0",
      "env": {
        "APP_VARIANT": "development"
      },
      "environment": "development",
      "developmentClient": true
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.20.0",
      "env": {
        "APP_VARIANT": "preview"
      },
      "environment": "preview",
      "developmentClient": false,
      "withoutCredentials": false,
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "production": {
      "autoIncrement": true,
      "developmentClient": false,
      "channel": "production",
      "distribution": "store",
      "withoutCredentials": false,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "node": "24.20.0",
      "env": {
        "APP_VARIANT": "production"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.attravoya.pro",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
