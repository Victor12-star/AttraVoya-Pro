# Browser-visible website configuration
# Every NEXT_PUBLIC_ value is readable by website visitors.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=AttraVoya Pro
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_CURRENCY=SEK
NEXT_PUBLIC_SUPPORT_EMAIL=

# Safe Ride uses a browser-visible Google Maps key by design. Never place server/private
# provider credentials here. Before enabling Safe Ride, restrict this Google key to the
# approved website origins and only the required Maps JavaScript API and Routes API.
# Keep the feature disabled until billing and the public privacy/terms requirements are ready.
NEXT_PUBLIC_SAFE_RIDE_GOOGLE_ENABLED=false
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
