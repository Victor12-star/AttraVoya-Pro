{
  "name": "@attravoya/server",
  "version": "0.1.0",
  "private": true,
  "description": "AttraVoya Pro Fastify REST API.",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env src/server.js",
    "build": "node ../../scripts/check-javascript.js .",
    "lint": "eslint . --max-warnings=0",
    "check:js": "node ../../scripts/check-javascript.js .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/tests/integration",
    "clean": "node -e \"const fs=require('node:fs'); for(const path of ['coverage','dist']) fs.rmSync(path,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@attravoya/constants": "workspace:*",
    "@attravoya/database": "workspace:*",
    "@attravoya/shared-types": "workspace:*",
    "@attravoya/utilities": "workspace:*",
    "@attravoya/validation": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "10.2.1",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "5.2.6",
    "argon2": "0.44.0",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "lru-cache": "11.5.2",
    "pino": "10.3.1",
    "resend": "6.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@attravoya/eslint-config": "workspace:*",
    "@attravoya/javascript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "pino-pretty": "13.1.3",
    "vitest": "4.1.10"
  }
}
