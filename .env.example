# -----------------------------------------------------------------------------
# AttraVoya Pro local development environment
# -----------------------------------------------------------------------------
# Copy this file to .env or run `node scripts/setup-development.js`.
# Never commit the real .env file.

# Core runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=5000
SHUTDOWN_GRACE_MS=25000
LOG_LEVEL=debug

# Local application URLs
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:5000
LIBRETRANSLATE_URL=http://localhost:5001

# PostgreSQL local Docker configuration
POSTGRES_DB=attravoya
POSTGRES_USER=attravoya
POSTGRES_PASSWORD=
DATABASE_URL=
SHADOW_DATABASE_URL=

# Per-process PostgreSQL pool budget. Production capacity planning must keep
# DB_POOL_MAX × API/worker replica count within the database/pooler connection budget.
DB_POOL_MAX=5
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Authentication and security
# Generate real development values locally. Do not reuse development secrets in production.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
AUTH_REFRESH_SESSION_DAYS=30
JWT_ISSUER=attravoya-pro-api
JWT_AUDIENCE=attravoya-pro
COOKIE_DOMAIN=
COOKIE_SECRET=
DATA_ENCRYPTION_KEY=

# Initial Super Admin — used only by an explicit initialization command
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Current provider selections
MAPS_PROVIDER=geoapify
PLACES_PROVIDER=geoapify
GEOCODING_PROVIDER=geoapify
ROUTING_PROVIDER=geoapify
ACCOMMODATION_PROVIDER=geoapify
ACCOMMODATION_INVENTORY_PROVIDER=none
WEATHER_PROVIDER=openmeteo
CURRENCY_PROVIDER=frankfurter
TRANSLATION_PROVIDER=libretranslate
EVENTS_PROVIDER=ticketmaster
NEWS_PROVIDER=newsdata
IMAGE_PROVIDER=pexels
EMAIL_PROVIDER=resend
FLIGHT_PROVIDER=none

# Current provider credentials
# Travel-provider keys can remain blank until the corresponding free account is created.
# Resend may also remain blank during local development, but production startup requires
# RESEND_API_KEY and EMAIL_FROM so verification/password-reset mail cannot silently fail.
GEOAPIFY_API_KEY=
TICKETMASTER_API_KEY=
NEWSDATA_API_KEY=
PEXELS_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Provider resilience and cost control
PROVIDER_TIMEOUT_MS=10000
PROVIDER_RETRY_MAX=2
WEATHER_CACHE_TTL_SECONDS=600
CURRENCY_CACHE_TTL_SECONDS=21600
PLACES_CACHE_TTL_SECONDS=3600
EVENTS_CACHE_TTL_SECONDS=3600
NEWS_CACHE_TTL_SECONDS=1800
IMAGES_CACHE_TTL_SECONDS=86400

# Credentialed-provider request budgets. Set BOTH values for a provider to match
# the actual allowance of the account/tier you deploy. Do not copy guessed quota
# numbers from this repository. Production requires a budget whenever the
# corresponding credentialed provider is enabled.
GEOAPIFY_REQUEST_BUDGET_MAX=
GEOAPIFY_REQUEST_BUDGET_WINDOW_SECONDS=
TICKETMASTER_REQUEST_BUDGET_MAX=
TICKETMASTER_REQUEST_BUDGET_WINDOW_SECONDS=
NEWSDATA_REQUEST_BUDGET_MAX=
NEWSDATA_REQUEST_BUDGET_WINDOW_SECONDS=
PEXELS_REQUEST_BUDGET_MAX=
PEXELS_REQUEST_BUDGET_WINDOW_SECONDS=
RESEND_REQUEST_BUDGET_MAX=
RESEND_REQUEST_BUDGET_WINDOW_SECONDS=

# Future providers — intentionally inactive during student development
DUFFEL_ACCESS_TOKEN=
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Local Docker LibreTranslate development defaults
LIBRETRANSLATE_LOAD_ONLY=en,sv,es,fr,de,it,pt,nl
LIBRETRANSLATE_THREADS=2
