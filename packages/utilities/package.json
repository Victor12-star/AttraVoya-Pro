{
  "name": "@attravoya/utilities",
  "version": "0.1.0",
  "private": true,
  "description": "Environment-neutral currency, date, and distance utilities for AttraVoya Pro.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./currency": "./src/currency.js",
    "./date": "./src/date.js",
    "./distance": "./src/distance.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "build": "node -e \"console.log('Utilities are source-consumed.')\"",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "node -e \"console.log('JavaScript package; static checking runs from the root jsconfig.')\""
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
