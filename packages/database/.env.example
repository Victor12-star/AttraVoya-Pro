# AttraVoya Pro database package environment template.
# Copy this file to packages/database/.env for local Prisma CLI commands.
# Keep real credentials out of Git, documentation, issues, and chat.

# Required for Prisma migrations, generation configuration, Studio, and seeding.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Optional dedicated shadow database used by `prisma migrate dev`.
# Leave blank when the PostgreSQL role may create and drop shadow databases.
SHADOW_DATABASE_URL=
