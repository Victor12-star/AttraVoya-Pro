{
  "$schema": "https://json.schemastore.org/jsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "customConditions": [
      "react-native"
    ],
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "types": [
      "react",
      "react-native"
    ]
  }
}
