{
  "name": "@attravoya/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod validation schemas for AttraVoya Pro API and domain inputs.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./auth": "./src/auth.js",
    "./destinations": "./src/destinations.js",
    "./trips": "./src/trips.js",
    "./search": "./src/search.js",
    "./subscriptions": "./src/subscriptions.js",
    "./accommodation": "./src/accommodation.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "build": "pnpm run check:js",
    "lint": "eslint . --max-warnings=0",
    "check:js": "node ../../scripts/check-javascript.js .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('coverage',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@attravoya/constants": "workspace:*",
    "@attravoya/shared-types": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@attravoya/eslint-config": "workspace:*",
    "@attravoya/javascript-config": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "4.1.10"
  }
}
