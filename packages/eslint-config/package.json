{
  "name": "@attravoya/eslint-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared JavaScript ESLint configurations for AttraVoya Pro.",
  "type": "module",
  "files": [
    "base.js",
    "next.js",
    "node.js",
    "react-native.js"
  ],
  "exports": {
    ".": "./base.js",
    "./base": "./base.js",
    "./next": "./next.js",
    "./node": "./node.js",
    "./react-native": "./react-native.js"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "peerDependencies": {
    "eslint": ">=10.9.0 <11"
  },
  "dependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.9.0"
  }
}
